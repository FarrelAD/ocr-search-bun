{
  "name": "ocr-search-bun",
  "version": "1.0.0",
  "description": "Fast OCR Image Search system using Bun, Tesseract.js, MySQL FULLTEXT search, CLI, and Web Dashboard",
  "main": "src/cli.ts",
  "license": "MIT",
  "keywords": [
    "bun",
    "ocr",
    "tesseract",
    "mysql",
    "fulltext-search",
    "image-search"
  ],
  "type": "module",
  "scripts": {
    "scan": "bun run src/cli.ts scan",
    "search": "bun run src/cli.ts search",
    "serve": "bun run src/cli.ts serve",
    "stats": "bun run src/cli.ts stats",
    "test": "bun test",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "tesseract.js": "^6.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "prisma": "7.10.0"
  }
}
