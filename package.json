{
  "name": "ocr-search-bun",
  "version": "1.0.0",
  "description": "Fast OCR Image Search system using Bun, Tesseract.js, MySQL FULLTEXT search, CLI, and Web Dashboard",
  "main": "src/cli.ts",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "keywords": [
    "bun",
    "ocr",
    "tesseract",
    "mysql",
    "fulltext-search",
    "image-search"
  ],
  "type": "module",
  "scripts": {
    "build:client": "bun build src/client/index.tsx --outfile public/app.js --minify",
    "scan": "bun run src/cli.ts scan",
    "search": "bun run src/cli.ts search",
    "serve": "bun run src/cli.ts serve",
    "stats": "bun run src/cli.ts stats",
    "test": "bun test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && tsc --noEmit",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:push": "prisma db push"
  },
  "lint-staged": {
    "*.{ts,js,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "latest",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prisma": "7.10.0",
    "typescript": "^7.0.2"
  }
}
